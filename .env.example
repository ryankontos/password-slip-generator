# Copy this file to .env. Non-blank values override app-managed settings.
# JSON values must remain valid JSON on one line. Leave remembered choices blank
# unless you want .env to keep them fixed.

# Application settings
PASSWORD_SLIPS_INPUT_FOLDER=~/Downloads
PASSWORD_SLIPS_OUTPUT_FOLDER=~/Downloads
PASSWORD_SLIPS_WORKBOOK_EXTENSIONS=[".xlsx",".xlsm"]
PASSWORD_SLIPS_COLUMN_LETTERS=
PASSWORD_SLIPS_PASSWORD_COLUMN_LETTERS=
PASSWORD_SLIPS_TRUNCATE_COLUMN_LETTERS=
PASSWORD_SLIPS_SAVED_ROW_FILTER_SETS=
PASSWORD_SLIPS_SELECTED_ROW_FILTERS=
PASSWORD_SLIPS_BLANK_SLIPS=
PASSWORD_SLIPS_EMAIL_ADDRESS=staff@example.com
# Each item adds a titled blank column to the summary table.
PASSWORD_SLIPS_EXTRA_SUMMARY_COLUMNS=["Notes","Follow-up"]

# Password-slip layout settings
PASSWORD_SLIPS_HEADER_HEIGHT_MM=20.0
PASSWORD_SLIPS_DATA_HEIGHT_MM=20.0
PASSWORD_SLIPS_SLIP_PADDING_MM=0.0
PASSWORD_SLIPS_TOP_MARGIN_MM=8.0
PASSWORD_SLIPS_BOTTOM_MARGIN_MM=8.0
PASSWORD_SLIPS_SIDE_MARGIN_MM=5.0
PASSWORD_SLIPS_COLUMN_GAP_MM=2.0
PASSWORD_SLIPS_PADDING_MM=2.0
PASSWORD_SLIPS_CUT_TICK_MM=4.0
PASSWORD_SLIPS_COLUMN_WIDTH_EVENNESS=0.55
PASSWORD_SLIPS_COLUMN_MIN_WIDTH_RATIO=0.07
PASSWORD_SLIPS_COLUMN_MAX_WIDTH_RATIO=0.45
PASSWORD_SLIPS_HEADER_COLOR=#0F4C81
PASSWORD_SLIPS_DATA_FONT=Helvetica-Bold
PASSWORD_SLIPS_PASSWORD_FONT=Courier-Bold
PASSWORD_SLIPS_HEADER_FONT_PT=11.0
PASSWORD_SLIPS_DATA_FONT_PT=12.0
PASSWORD_SLIPS_MINIMUM_FONT_PT=4.0
PASSWORD_SLIPS_SHOW_FOOTER=true
PASSWORD_SLIPS_SHOW_SHEET_NAME=true
PASSWORD_SLIPS_SHOW_GENERATED_DATETIME=true
PASSWORD_SLIPS_SHOW_PAGE_NUMBERS=true
PASSWORD_SLIPS_FOOTER_FONT_PT=7.5
PASSWORD_SLIPS_FOOTER_COLOR=#555555
